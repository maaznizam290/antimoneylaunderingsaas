# ── Database ────────────────────────────────────────────────────────────────
# Dev fallback: local SQLite file. Note: Prisma resolves a relative sqlite
# path relative to prisma/schema.prisma's directory, so "./dev.db" here
# means prisma/dev.db, not <project root>/dev.db. For production, point to
# PostgreSQL instead, e.g. postgresql://user:password@host:5432/verifin?schema=public
DATABASE_URL="file:./dev.db"

# ── AI: Gemini via Genkit ───────────────────────────────────────────────────
# Leave unset in dev to run the deterministic fallback analyzer (clearly
# labeled as degraded/non-AI mode in the UI and audit log). Set a real key to
# enable Gemini-backed KYC/AML/summary analysis.
GEMINI_API_KEY=

# ── File storage ────────────────────────────────────────────────────────────
# Dev fallback: local disk under ./storage. Swap FileStorageService for an
# S3/GCS/Supabase-Storage-backed implementation in production and set these
# accordingly (not read by the local implementation).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Verifin
