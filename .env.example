# ── Database ────────────────────────────────────────────────────────────────
# Required, including for local development — PostgreSQL. A free instance
# from Neon, Supabase, or Vercel Postgres works fine, or run Postgres
# locally (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`).
# This CANNOT be a local SQLite file in production: Vercel's function
# filesystem is read-only outside /tmp, and /tmp is wiped between
# invocations and not shared across instances, so a file-based database
# breaks (500s on every DB read/write) the moment this app is deployed
# there. See README.md "Deploying to Vercel".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verifin?schema=public"

# ── AI: Gemini via Genkit ───────────────────────────────────────────────────
# Leave unset in dev to run the deterministic fallback analyzer (clearly
# labeled as degraded/non-AI mode in the UI and audit log). Set a real key to
# enable Gemini-backed KYC/AML/summary analysis.
GEMINI_API_KEY=

# ── File storage ────────────────────────────────────────────────────────────
# Local disk under ./storage. This is the ONLY implementation currently
# wired up (getFileStorage() always returns LocalDiskStorage — the
# STORAGE_DRIVER value below is not read by code yet, it's a placeholder
# for the next storage backend). Same problem as SQLite: on Vercel, disk
# writes under the deployment's working directory fail (read-only
# filesystem outside /tmp), so uploads will 500 there even after the
# database is fixed. See README.md "Deploying to Vercel" before deploying
# any environment where users will upload files.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Verifin
